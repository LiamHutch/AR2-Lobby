{
	"name": "AR2 Lobby",

	"servePlaceIds": [9350655892, 863266079],

	"tree": {
		"$className": "DataModel",

		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"$ignoreUnknownInstances": true,

			"Shared": {
				"$className": "Folder",
				"$path": "src/Shared"
			},

			"Remotes": {
				"$className": "Folder",
				"Directory": { "$className": "RemoteEvent" },
				"Play": { "$className": "RemoteEvent" },
				"Status": { "$className": "RemoteEvent" },
				"Private": { "$className": "RemoteEvent" }
			}
		},

		"ServerScriptService": {
			"$className": "ServerScriptService",
			"$ignoreUnknownInstances": true,

			"Lobby": {
				"$className": "Folder",
				"$path": "src/Server"
			}
		},

		"ReplicatedFirst": {
			"$className": "ReplicatedFirst",
			"$ignoreUnknownInstances": true,

			"Browser": {
				"$path": "src/Client/Browser"
			}
		},

		"Players": {
			"$className": "Players",
			"$properties": {
				"CharacterAutoLoads": false
			}
		}
	}
}
